set vb t_vb=
set visualbell
set noerrorbells
set smartcase
set background=dark

autocmd VimEnter * set nospell

" airline 
let g:airline_powerline_fonts = 1
let g:airline_detect_modified=1
let g:airline_theme='term' " molokai, term, 'luna'

call airline#parts#define_accent('mode', 'none')
if !exists('g:airline_symbols')
    let g:airline_symbols = {}
endif
let g:airline#extensions#tabline#enabled = 1
let g:airline#extensions#tabline#formatter = 'unique_tail'
let g:airline#extensions#nerdtree_statusline = 1

" ---------------------> Ack <---------------------
cnoreabbrev Ack Ack!
nnoremap <nowait> <Leader><Leader>a :Ack!<Space>
" 让ack.vim使用ag作为搜索工具, 先安装ag: brew install ag
let g:ackprg = 'ag --nogroup --column'

" ---------------------> fzf <---------------------
" https://www.bilibili.com/video/BV1254y1e71F/?vd_source=6aafb4e5f1c858dd679e8850c5d6f1f7
" for preview syntax highlight: brew install bat 
nnoremap <C-f> :Files<Cr>
nnoremap <C-p> :Buffers<Cr>
nnoremap <C-h> :History<Cr>
" let g:fzf_layout = {'down' : '40%'}
"

" vim-go
let g:go_highlight_functions = 1
let g:go_highlight_methods = 1
let g:go_highlight_extra_types = 1
let g:go_doc_keywordprg_enabled = 0 "disable map 'K' to 'GoDoc'
"let g:go_fmt_command = "goimports"
let g:go_fmt_command = 'gopls'
" autocmd FileType go nmap <Leader>i <Plug>(go-info)

hi Pmenu term=reverse ctermbg=244
hi PmenuSel term=reverse ctermbg=239
" hi CursorColumn guibg=#124b7f term=reverse ctermbg=239
" hi CursorLine term=underline cterm=underline ctermbg=236 guibg=#2c323c gui=underline
" hi CursorLine ctermbg=236 guibg=#2c323c
