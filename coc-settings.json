{
    "java.home": "/usr/local/opt/jdk1.8.0_351.jdk/Contents/Home/",
    "java.trace.server": "verbose",
    "java.configuration.maven.userSettings":"/Users/zl/.m2/settings.xml",
    "java.saveActions.organizeImports":true,
    "go.goplsOptions": {
        "staticcheck": true,
    },
    "go.goplsUseDaemon": false,
    "python.analysis.diagnosticSeverityOverrides": {
        "reportGeneralTypeIssues": "none",
        "reportUnusedImport": "warning",
        "reportUnusedClass": "warning",
        "reportUnusedFunction": "warning",
        "reportUnusedVariable": "warning"
    },
    "python.pythonPath": "/opt/homebrew/bin/python3",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": true,
    "python.linting.flake8Args": [
        "--ignore=E501,W601"
    ],
    "links.enable":true,
    "colors.enable":true,
    "coc.preferences.jumpCommand": "drop",
    "diagnostic.checkCurrentLine": true,
    "tsserver.npm": "/opt/homebrew/bin/npm",
    "rust-analyzer.rustfmt.rangeFormatting.enable": true,
    "rust-analyzer.updates.checkOnStartup": false,
    "rust-analyzer.updates.channel": "stable",
    "marketplace.npmsio": true,
    "suggest.pumFloatConfig": {
        "-winblend": 15,
        "-highlight": "#FFF8DC"
    }
}
